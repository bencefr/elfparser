{
    "name": "@bencefrenyo/elfparser",
    "version": "0.1.0",
    "description": "Parse ELF binaries and resolve DWARF symbol locations.",
    "license": "Apache License 2.0",
    "author": "Bence Frenyo",
    "publisher": "Bence Frenyo",
    "repository": {
        "type": "git",
        "url": "https://github.com/bencefr/elfparser"
    },
    "categories": [
        "Debuggers"
    ],
    "keywords": [
        "elf",
        "elf-parser",
        "elf-binary",
        "dwarf",
        "debug-symbols",
        "symbol-table",
        "binary-analysis",
        "wasm",
        "webassembly",
        "typescript",
        "nodejs",
        "debugging"
    ],
    "type": "commonjs",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "require": "./lib/index.js",
            "default": "./lib/index.js"
        }
    },
    "files": [
        "lib"
    ],
    "scripts": {
        "build:wasm": "cargo build --manifest-path wasm-elf-parser/Cargo.toml --target wasm32-unknown-unknown --release",
        "build:bindings": ". \"$HOME/.cargo/env\" 2>/dev/null || true; rm -rf lib/wasm && mkdir -p lib/wasm && wasm-bindgen wasm-elf-parser/target/wasm32-unknown-unknown/release/wasm_elf_parser.wasm --out-dir lib/wasm --target nodejs",
        "build:typescript": "tsc",
        "build": "npm run build:wasm && npm run build:bindings && npm run build:typescript",
        "prepack": "npm run build",
        "test": "jest --runInBand"
    },
    "devDependencies": {
        "@types/node": "^26.6.2",
        "jest": "^30.5.2",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
